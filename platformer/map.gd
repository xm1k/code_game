func _ready() -> void:
	load_level(current_level_index)

func load_level(index: int) -> void:
	if index < 0 or index >= levels.size(): 
		return
		
	var level_data = levels[index]
	
	# Рисуем уровень
	for y in range(level_data.size()):
		var row = level_data[y]
		for x in range(row.length()):
			if row[x] == "X":
				set_cell(Vector2i(x, y), source_id, ground_atlas_coords)
			elif row[x] == "Y":
				set_cell(Vector2i(x, y), source_id, portal_atlas_coords)
